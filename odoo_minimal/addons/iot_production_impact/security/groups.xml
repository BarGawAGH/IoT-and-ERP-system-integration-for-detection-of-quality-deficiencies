<odoo>
    <record id="privilege_production_impact" model="res.groups.privilege">
        <field name="name">IoT production decisions</field>
        <field name="category_id" ref="iot_poc_community.category_iot_prototype"/>
    </record>
    <record id="group_impact_manager" model="res.groups">
        <field name="name">Production impact manager</field>
        <field name="privilege_id" ref="privilege_production_impact"/>
        <field name="implied_ids" eval="[(4, ref('iot_poc_community.group_manager')), (4, ref('mrp.group_mrp_manager')), (4, ref('stock.group_stock_manager')), (4, ref('purchase.group_purchase_manager'))]"/>
        <field name="comment">Runs explicitly marked simulation dispositions and manages historical holds. Does not grant the integration bridge role.</field>
    </record>
</odoo>
