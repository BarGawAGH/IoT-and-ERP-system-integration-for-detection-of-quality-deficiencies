<odoo>
    <record id="view_machine_list" model="ir.ui.view">
        <field name="name">iot.poc.machine.list</field><field name="model">iot.poc.machine</field>
        <field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/></list></field>
    </record>
    <record id="view_machine_form" model="ir.ui.view">
        <field name="name">iot.poc.machine.form</field><field name="model">iot.poc.machine</field>
        <field name="arch" type="xml">
            <form><sheet>
                <div class="alert alert-info" role="alert">This is a demonstration alias. The historical dataset does not identify the physical machine.</div>
                <group><field name="name"/><field name="code"/><field name="company_id" groups="base.group_multi_company"/></group>
                <field name="mapping_ids" readonly="True"><list create="false" delete="false"><field name="code"/><field name="cycle_label"/><field name="production_id"/><field name="lot_id"/></list></field>
            </sheet></form>
        </field>
    </record>
    <record id="view_mapping_list" model="ir.ui.view">
        <field name="name">iot.poc.mapping.list</field><field name="model">iot.poc.mapping</field>
        <field name="arch" type="xml"><list><field name="code"/><field name="machine_id"/><field name="cycle_label"/><field name="production_id"/><field name="product_id"/><field name="lot_id"/><field name="mapping_kind"/></list></field>
    </record>
    <record id="view_mapping_form" model="ir.ui.view">
        <field name="name">iot.poc.mapping.form</field><field name="model">iot.poc.mapping</field>
        <field name="arch" type="xml">
            <form><sheet>
                <div class="alert alert-warning" role="alert">ERP orders and lots are demonstration context. This mapping does not claim that the historical samples came from these orders. One cycle maps to one single-unit MO. A used mapping is frozen.</div>
                <group>
                    <group><field name="name"/><field name="code"/><field name="company_id" groups="base.group_multi_company"/><field name="machine_id"/><field name="dataset_sha256"/><field name="cycle_label"/></group>
                    <group><field name="production_id"/><field name="product_id"/><field name="lot_id"/><field name="mapping_kind" readonly="True"/><field name="historical_mapping_verified"/></group>
                </group>
            </sheet></form>
        </field>
    </record>
    <record id="action_machines" model="ir.actions.act_window"><field name="name">Machines</field><field name="res_model">iot.poc.machine</field><field name="view_mode">list,form</field></record>
    <record id="action_mappings" model="ir.actions.act_window"><field name="name">Mappings</field><field name="res_model">iot.poc.mapping</field><field name="view_mode">list,form</field></record>
</odoo>
